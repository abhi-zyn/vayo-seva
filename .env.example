# Copy to .env.local (never commit it). Server-side only: none of these reach the browser.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model names change often: check https://ai.google.dev/gemini-api/docs/models before a demo.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Tried in order when the main model is overloaded or rate-limited
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts
GEMINI_EMBED_MODEL=gemini-embedding-001

# Where finished applications go.
#   "dummy"  = logged on the server with IDs masked (default, nothing is sent)
#   "resend" = emailed to the Akshaya operator via Resend, with scanned PDFs attached
DELIVERY_MODE=dummy

# Resend (only used when DELIVERY_MODE=resend). Key from https://resend.com/api-keys
RESEND_API_KEY=
# Who receives applications. Several addresses: separate with commas.
OPERATOR_EMAIL=
# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev), which only
# delivers to the email address of your own Resend account. To send to anyone else,
# verify a domain in Resend and use e.g.: VayoSeva <applications@yourdomain.in>
DELIVERY_FROM=

# --- Accounts (Supabase + Google sign-in). Leave empty = no login, nothing saved. ---
# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC_. Bypasses row-level security: keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Razorpay). Leave empty = no fee, apply for free. ---
# Razorpay Dashboard → Account & Settings → API Keys (use Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID (it's public); lets the screen show the fee.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay → Webhooks → the secret you type when adding /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# "all" = send the whole knowledge base to the model (default, fine for a few dozen entries)
# "embed" = embed entries once, send only the top 3 matches
RETRIEVAL_MODE=all
